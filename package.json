{
  "name": "opencode-monitor",
  "version": "0.2.1",
  "description": "A Monitor-equivalent tool for OpenCode: block on an external condition without spending agent turns.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futpib/opencode-monitor.git"
  },
  "homepage": "https://github.com/futpib/opencode-monitor#readme",
  "bugs": "https://github.com/futpib/opencode-monitor/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "monitor",
    "agent",
    "watcher"
  ],
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "bin": {
    "opencode-monitor": "src/cli.ts"
  },
  "oc-plugin": [
    "tui"
  ],
  "exports": {
    "./server": {
      "default": "./src/server.ts"
    },
    "./tui": {
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "test": "npm run build && node --test --test-reporter=spec",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "build": "node scripts/build-tui.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.7",
    "@opentui/core": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "solid-js": "^1.8.0",
    "xdg-basedir": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "1.9.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
